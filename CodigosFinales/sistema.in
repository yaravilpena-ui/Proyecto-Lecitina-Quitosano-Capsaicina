bond_style harmonic
bond_coeff 1 50.0 0.7

angle_style harmonic
angle_coeff 1 25.0 170
angle_coeff 2 5.0  175
angle_coeff 3 5.0  118.5

comm_modify     vel yes
comm_modify     cutoff 1.0
neighbor        0.6 bin
neigh_modify    delay 0 every 1 check yes

minimize 1.0e-4 1.0e-6 1000 10000
reset_timestep 0

velocity all create 1.0 12345

timestep 0.03
fix 1 all nve

thermo 1000
thermo_style custom step temp epair emol ke etotal press

dump 1 all custom 1000 trayectoriaG.lammpstrj id mol type x y z

run 5000000

write_restart final.sistemG.restart
